{{!-- vme-insight tab: one Grafana dashboard in kiosk mode, plus a link to open it full size. --}}
<div class="vme-insight-tab" style="padding: 8px 0;">
	<div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px;">
		<span style="font-weight: 600;">{{title}}</span>
		<a href="{{openUrl}}" target="_blank" rel="noopener noreferrer">Open in vme-insight &#8599;</a>
	</div>
	{{#if insecure}}
	<p class="text-warning" style="margin-bottom: 8px;">
		The vme-insight URL uses http. Browsers block http frames inside VME's https pages, so this tab may stay blank.
		Serve Grafana over https and update the plugin settings. The link above still works.
	</p>
	{{/if}}
	<iframe src="{{embedUrl}}" title="vme-insight: {{title}}" width="100%" height="{{height}}"
		frameborder="0" loading="lazy" referrerpolicy="no-referrer"
		style="width: 100%; border: 0; display: block;"></iframe>
	<p class="text-muted" style="margin-top: 6px; font-size: 12px;">
		From vme-insight at {{grafana}}. Blank or asking you to sign in? See the plugin's <a href="https://github.com/grahamfairbank/vme-insight-plugin/blob/main/docs/TROUBLESHOOTING.md" target="_blank" rel="noopener noreferrer">troubleshooting guide &#8599;</a>.
	</p>
</div>
